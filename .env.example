# ==============================================================================
# Sanjivani Clinical Intake Assistant - Environment Configuration Template
# ==============================================================================

# --- Global / Server Settings ---
PROJECT_NAME="Sanjivani Clinical Intake Assistant"
API_V1_PREFIX="/api/v1"
DEBUG=False
START_VLLM=true
VLLM_MAX_LEN=4096
VLLM_GPU_UTIL=0.88
VLLM_QUANT=bitsandbytes

# ==============================================================================
# 1. GOOGLE GEMINI CONFIGURATION (Cloud Multimodal LLM & VLM)
# ==============================================================================
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/):
# When GEMINI_API_KEY is provided, Sanjivani automatically connects to Google's
# high-speed multimodal Gemini endpoint without needing local vLLM or GPU VRAM.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
# Alternative models: gemini-2.5-pro, gemini-1.5-flash, gemini-2.0-flash

# ==============================================================================
# 2. LOCAL VLLM / OPEN-SOURCE MODEL CONFIGURATION (Optional fallback)
# ==============================================================================
# Local vLLM server running google/medgemma-1.5-4b-it or Qwen2.5-VL
TEXT_LLM_API_KEY=EMPTY
TEXT_LLM_MODEL_NAME=gemini-2.5-flash
TEXT_LLM_BASE_URL=

# ==============================================================================
# 2. VISION / MULTIMODAL VLM DOCUMENT SCANNER (Local vLLM MedGemma on Port 8001)
# ==============================================================================
# Default: Local vLLM multimodal server
VISION_LLM_API_KEY=EMPTY
VISION_LLM_MODEL_NAME=google/medgemma-1.5-4b-it
VISION_LLM_BASE_URL=http://localhost:8001/v1

# ==============================================================================
# 3. GLOBAL / LEGACY FALLBACKS
# ==============================================================================
OPENAI_API_KEY=EMPTY
OPENAI_MODEL_NAME=google/medgemma-1.5-4b-it
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_VISION_MODEL_NAME=google/medgemma-1.5-4b-it

# ==============================================================================
# 4. RELATIONAL DATABASE (Local Zero-Cost SQLite or Cloud PostgreSQL)
# ==============================================================================
# Default: Local zero-cost asynchronous SQLite database
DATABASE_URL=sqlite+aiosqlite:///./sanjivani.db
# Cloud Alternative (e.g. Supabase or Neon PostgreSQL free tier):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
