# ==============================================================================
# Sanjivani Clinical Intake Assistant - Environment Configuration Template
# ==============================================================================

# --- Global / Server Settings ---
PROJECT_NAME="Sanjivani Clinical Intake Assistant"
API_V1_PREFIX="/api/v1"
DEBUG=False

# ==============================================================================
# 1. TEXT / CONVERSATIONAL CHAT INTAKE LLM (SOCRATES + Dashavidha Pariksha)
# ==============================================================================
# API key and endpoint for conversational clinical triage
TEXT_LLM_API_KEY=your_text_llm_api_key_here
TEXT_LLM_MODEL_NAME=openai/gpt-oss-120b
TEXT_LLM_BASE_URL=https://api.groq.com/openai/v1

# ==============================================================================
# 2. VISION / MULTIMODAL VLM DOCUMENT SCANNER (Prescriptions & Lab Reports)
# ==============================================================================
# API key and endpoint for document image OCR and entity extraction
VISION_LLM_API_KEY=your_vision_llm_api_key_here
VISION_LLM_MODEL_NAME=qwen/qwen3.6-27b
VISION_LLM_BASE_URL=https://api.groq.com/openai/v1

# ==============================================================================
# 3. GLOBAL / LEGACY FALLBACKS (Optional backward compatibility)
# ==============================================================================
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL_NAME=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_VISION_MODEL_NAME=qwen/qwen3.6-27b
